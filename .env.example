# Copy to .env and fill in. Never commit .env: it holds secrets.
# Every variable is described in README.md, "Run with Docker" and "Sign-in".

# --- Database (required) ---------------------------------------------------------------
# Avoid characters that need URL encoding (such as @ : / ? #) in both passwords.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
POSTGRES_USER=potencializador
POSTGRES_DB=potencializador

# --- Web application ---------------------------------------------------------------------
WEB_PORT=8080
# Address the browser uses. With https, cookies are marked Secure.
PUBLIC_URL=http://localhost:8080
SESSION_TTL_HOURS=12

# Comma-separated emails of the mentoring firm's people, created as super administrators.
SUPER_ADMIN_EMAILS=

# --- Sign-in with Google (optional: set both or neither) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign-in with Microsoft (optional: set both or neither) -----------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common, organizations, or one tenant id.
MICROSOFT_TENANT=common

# --- Mail, for email and password sign-in (optional: set all or none) -------------------
# Google Workspace: smtp.gmail.com, port 465, the sending account and an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender: the same account, or an alias it may send as.
SMTP_FROM=
