# ~/potencializador/.env on the server. deploy/setup-server.sh creates it from this file with both
# database passwords generated; fill in the rest by hand. Never commit it: it holds secrets.
# Every variable is described in README.md, "Run with Docker", "Sign-in" and "Deploy".

# --- Database (generated by setup-server.sh) -------------------------------------------
# Owner of potencializador_production in the shared postgres; used only by migrations.
OWNER_DB_PASSWORD=
# Password of potencializador_app, the restricted role the API connects as.
APP_DB_PASSWORD=

# --- Web application ---------------------------------------------------------------------
PUBLIC_URL=https://potencializador-de-rol.lab.kleer.la
SESSION_TTL_HOURS=12

# Comma-separated emails of the mentoring firm's people, created as super administrators.
SUPER_ADMIN_EMAILS=

# --- Sign-in with Google (optional: set both or neither) --------------------------------
# Redirect URI: https://potencializador-de-rol.lab.kleer.la/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign-in with Microsoft (optional: set both or neither) -----------------------------
# Redirect URI: https://potencializador-de-rol.lab.kleer.la/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Mail, for email and password sign-in ---------------------------------------------
# Google Workspace SMTP relay, like Kleer's other applications: it accepts this server by its
# address (allowed in the Admin console), so no user or password. SMTP_FROM: an address of the domain.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
