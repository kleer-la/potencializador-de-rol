{
  "name": "potencializador-de-rol",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/domain && tsc -p apps/api && tsc -p apps/web",
    "dev:api": "npm run dev --workspace @potencializador/api",
    "dev:web": "npm run dev --workspace @potencializador/web"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
